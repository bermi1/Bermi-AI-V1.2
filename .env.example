# ---- AI (server-side only — NEVER exposed to the client/browser) ----
OPENROUTER_API_KEY=

# Model used for invoice/document drafting (any OpenRouter id)
DRAFT_MODEL=anthropic/claude-haiku-4.5

# ---- Server ----
PORT=3001
# Public base URL, used for OAuth redirect URIs in production
PUBLIC_URL=

# ---- Database ----
# With both set, Bermi stores everything in your Supabase project (tables are
# prefixed bermi_*). Unset -> falls back to local SQLite in server/data/.
# Prefer the service_role key server-side; the anon key also works with the
# shipped permissive RLS policies.
SUPABASE_URL=
SUPABASE_KEY=

# ---- Connectors (OAuth apps) ----
# Google: create OAuth credentials at https://console.cloud.google.com/apis/credentials
# with redirect URI  <PUBLIC_URL or http://localhost:3001>/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- PDF export ----
# Optional path to a Chromium/Chrome binary (auto-detected when unset)
CHROME_PATH=
